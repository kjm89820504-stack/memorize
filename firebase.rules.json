{
  "rules": {
    ".read": false,
    ".write": false,

    "usernames": {
      ".read": true,
      "$username": {
        ".write": "auth != null && !data.exists() && newData.isString() && newData.val() == auth.uid",
        ".validate": "newData.isString()"
      }
    },

    "profiles": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    "folders": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        ".indexOn": ["createdAt"]
      }
    },

    "sets": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        ".indexOn": ["folderId", "createdAt", "updatedAt"]
      }
    },

    "reviewLogs": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        ".indexOn": ["setId", "createdAt"]
      }
    }
  }
}
